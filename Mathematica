In[10]:= 
phi1[x_, y_, xa_, xb_, ya_, 
  yb_] := ((xb - x)*(yb - y))/((xb - xa)*(yb - ya))
phi2[x_, y_, xa_, xb_, ya_, 
  yb_] := ((x - xa)*(yb - y))/((xb - xa)*(yb - ya))
phi3[x_, y_, xa_, xb_, ya_, 
  yb_] := ((x - xa)*(y - ya))/((xb - xa)*(yb - ya))
phi4[x_, y_, xa_, xb_, ya_, 
  yb_] := ((xb - x)*(y - ya))/((xb - xa)*(yb - ya))

